# Copy to .env and fill in. .env is gitignored; never commit the real key.
OPENAI_API_KEY=sk-...

# server.py's extraction backend (k2-horizon-7b). Defaults to localhost:8100 if
# unset. Point this at the Modal deployment's URL + /v1 once `modal deploy
# modal/serve_k2.py` prints it (see modal/serve_k2.py for the deploy steps).
VLLM_URL=https://<workspace>--k2-horizon-rfp-serve.modal.run/v1

# datalab-to/lift, served locally via vLLM (see serve.sh). No key needed for a
# local server; only set LIFT_API_KEY if you put one in front of it yourself.
LIFT_BASE_URL=http://127.0.0.1:8200/v1
LIFT_MODEL=datalab-to/lift
LIFT_API_KEY=
